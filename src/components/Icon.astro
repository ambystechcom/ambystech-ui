---
import { ICONS, type IconName } from '../data/icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 16, class: className } = Astro.props;
const icon = ICONS[name];
---

<svg
  aria-hidden="true"
  focusable="false"
  width={size}
  height={size}
  viewBox={icon.viewBox}
  fill="currentColor"
  class:list={['block shrink-0', className]}
><path d={icon.d} /></svg>
